# ============================================
# DATABASE CONFIGURATION
# ============================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpresspass

# ============================================
# WORDPRESS CONFIGURATION
# ============================================
WORDPRESS_DEBUG=false
WORDPRESS_ENV=development

# ============================================
# BANCO DE CHILE - WEBCHECKOUT CREDENTIALS
# ============================================
# Ambiente: development, staging, production
BCH_ENVIRONMENT=development

# Credenciales Banco de Chile
BCH_COMMERCE_CODE=123456789
BCH_API_KEY=your_api_key_here
BCH_SECRET_KEY=your_secret_key_here

# URLs de Banco de Chile
# Desarrollo: https://webpay-test.transbank.cl
# Producción: https://webpay.transbank.cl
BCH_SANDBOX_URL=https://webpay-test.transbank.cl
BCH_PRODUCTION_URL=https://webpay.transbank.cl

# Callback URL (donde Banco de Chile enviará notificaciones)
BCH_CALLBACK_URL=http://localhost:8080/wp-json/adventure-tourism/v1/payment-callback

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@aventura-tourism.com
SMTP_FROM_NAME=Aventura Tourism

# ============================================
# SITE CONFIGURATION
# ============================================
SITE_URL=http://localhost:8080
SITE_TITLE=Aventura Tourism - Tours de Aventura
SITE_DESCRIPTION=Experimenta emocionantes tours de aventura en Chile
ADMIN_EMAIL=admin@aventura-tourism.com

# ============================================
# SECURITY
# ============================================
# Generar con: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=put_your_unique_phrase_here
SECURE_AUTH_KEY=put_your_unique_phrase_here
LOGGED_IN_KEY=put_your_unique_phrase_here
NONCE_KEY=put_your_unique_phrase_here
AUTH_SALT=put_your_unique_phrase_here
SECURE_AUTH_SALT=put_your_unique_phrase_here
LOGGED_IN_SALT=put_your_unique_phrase_here
NONCE_SALT=put_your_unique_phrase_here

# ============================================
# API KEYS (OPTIONAL)
# ============================================
# Google Maps API (para ubicación de tours)
GOOGLE_MAPS_API_KEY=

# Google Analytics
GOOGLE_ANALYTICS_ID=

# SendGrid (alternativa a SMTP)
SENDGRID_API_KEY=

# ============================================
# DEVELOPERS
# ============================================
LOG_LEVEL=debug
ENABLE_QUERY_MONITOR=true
